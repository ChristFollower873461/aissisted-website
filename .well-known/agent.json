{
  "version": "0.2",
  "profile": "agent-surface",
  "site": {
    "name": "AIssisted Consulting",
    "domain": "aissistedconsulting.com",
    "intent": "Public website for a founder-led AI and software implementation company serving small businesses and individuals through workflow improvement and custom development. Booking and contact actions preserve human approval, exact terms, idempotency, audit, and Stripe-hosted payment boundaries.",
    "registryVersion": "2026-08-15.2",
    "registrySha256": "02bc61929ddaacfd542f970d5e2fc7f297c90cda00948def98ed2758667031b2"
  },
  "discovery": {
    "sitemap": "/sitemap.xml",
    "llmsTxt": "/llms.txt",
    "agentSkills": "/.well-known/agent-skills/index.json"
  },
  "protocols": {
    "agentSkills": {
      "index": "/.well-known/agent-skills/index.json",
      "profile": "static_companion_index",
      "capabilityBoundary": "References public read commands, draft helpers, a same-origin contact submission endpoint with AICCRM intake relay when configured, and a Stripe Checkout creation endpoint. Write and financial commands require human approval, Idempotency-Key, duplicate protection, and server-side validation. It does not expose destructive, auth, direct CRM administration, email, storage-browser, or direct card-collection commands."
    }
  },
  "commands": [
    {
      "id": "get_site_overview",
      "title": "Get public site overview",
      "description": "Returns the public company message, small-business and individual paths, two service lanes, primary paid plan, privacy boundaries, and contact routes.",
      "risk": "read_only",
      "requiresHumanApproval": false,
      "fallback": {
        "type": "browser_page",
        "url": "/",
        "selectors": {
          "headline": "h1",
          "smallBusinessPath": "[data-agent='audience-small-business']",
          "services": "[data-agent='services']",
          "privacyControl": "[data-agent='privacy-control']",
          "booking": "a[href$='/book/'], a[href='./book/'], a[href='../book/'], [data-agent='booking']",
          "contact": "[data-agent='contact']",
          "individualPath": "[data-agent='audience-individual']"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "overview",
              "small_business",
              "individual",
              "workflow_improvement",
              "custom_development",
              "services",
              "privacy",
              "booking",
              "contact"
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "headline": {
            "type": "string"
          },
          "smallBusinessPath": {
            "type": "string"
          },
          "services": {
            "type": "string"
          },
          "privacyControl": {
            "type": "string"
          },
          "booking": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          },
          "individualPath": {
            "type": "string"
          }
        }
      },
      "successCriteria": "Agent reads public facts from declared page regions only."
    },
    {
      "id": "get_business_profile",
      "title": "Get public business profile",
      "description": "Returns the approved founder-led AI and software implementation identity, audiences, two service lanes, offer boundary, location, and contact facts.",
      "risk": "read_only",
      "requiresHumanApproval": false,
      "method": "GET",
      "endpoint": "/api/business-profile.json",
      "outputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "public_brand": {
            "type": "string"
          },
          "founder_operator": {
            "type": "object"
          },
          "contact": {
            "type": "object"
          },
          "base_location": {
            "type": "object"
          },
          "service_area": {
            "type": "object"
          },
          "primary_audiences": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "privacy_control_posture": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "successCriteria": "Agent reads public business facts from a static JSON feed."
    },
    {
      "id": "get_services",
